<Window x:Class="FortniteAFKXPMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fortnite AFK XP Tool" Width="500" SizeToContent="Height" ResizeMode="CanMinimize"
        Background="{StaticResource Bg}" Icon="Assets/icon.ico"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20">

        <TextBlock Text="Fortnite AFK XP Tool" FontSize="22" FontWeight="Bold" Margin="0,0,0,2"/>
        <TextBlock Text="Auto-click, hold input and camera nudges for GeForce NOW, GeForce Infinity, Amazon Luna, Xbox Cloud and Fortnite."
                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <!-- Status -->
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="STATUS" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="StatusText" Text="Stopped" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="TargetText" Foreground="{StaticResource TextMuted}" Margin="0,2,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Next camera nudge" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock x:Name="NudgeCountdown" Text="--:--" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Since last camera input" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock x:Name="SinceNudge" Text="--:--" FontSize="26" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <ProgressBar x:Name="TimeoutBar" Height="6" Minimum="0" Maximum="420" Value="0" Margin="0,10,0,4"
                             Background="#12131C" Foreground="{StaticResource Accent}" BorderThickness="0"/>
                <TextBlock x:Name="StatsText" Foreground="{StaticResource TextMuted}" FontSize="11"
                           Text="7:00 XP timeout window"/>
            </StackPanel>
        </Border>

        <!-- Settings -->
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel x:Name="SettingsPanel">
                <TextBlock Text="INPUT" Style="{StaticResource SectionTitle}"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="ActionMouse" Content="Mouse click" GroupName="action" IsChecked="True"/>
                    <RadioButton x:Name="ActionKey" Content="Keystroke" GroupName="action"/>
                </StackPanel>

                <StackPanel x:Name="MouseRow" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Button" Foreground="{StaticResource TextMuted}" Width="70" VerticalAlignment="Center"/>
                    <RadioButton x:Name="BtnLeft" Content="Left" GroupName="btn" IsChecked="True"/>
                    <RadioButton x:Name="BtnRight" Content="Right" GroupName="btn"/>
                    <RadioButton x:Name="BtnMiddle" Content="Middle" GroupName="btn"/>
                </StackPanel>

                <StackPanel x:Name="KeyRow" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock Text="Key" Foreground="{StaticResource TextMuted}" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="KeyBox" Width="140" IsReadOnly="True" Text="Space" Cursor="Arrow"
                             ToolTip="Click, then press the key to use"
                             PreviewKeyDown="KeyBox_PreviewKeyDown"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Mode" Foreground="{StaticResource TextMuted}" Width="70" VerticalAlignment="Center"/>
                    <RadioButton x:Name="ModeAuto" Content="Auto (repeat)" GroupName="mode" IsChecked="True"/>
                    <RadioButton x:Name="ModeHold" Content="Hold" GroupName="mode"/>
                </StackPanel>

                <StackPanel x:Name="IntervalRow" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Interval" Foreground="{StaticResource TextMuted}" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="IntervalBox" Width="80" Text="100"/>
                    <TextBlock Text="ms between presses" Foreground="{StaticResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel x:Name="NudgePanel">
                <TextBlock Text="ANTI-AFK CAMERA NUDGE" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Every" Foreground="{StaticResource TextMuted}" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="NudgeMinutesBox" Width="80" Text="5"/>
                    <TextBlock Text="minutes (±10%, max 6:30)" Foreground="{StaticResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Distance" Foreground="{StaticResource TextMuted}" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="NudgePixelsBox" Width="80" Text="60"/>
                    <TextBlock Text="pixels (varied each time), then returns" Foreground="{StaticResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox x:Name="RequireTargetBox" IsChecked="True">
                    <TextBlock TextWrapping="Wrap"
                               Text="Only send input while Fortnite, GeForce NOW, GeForce Infinity, Amazon Luna or Xbox Cloud is focused"/>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- Controls -->
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ToggleButton" Content="Start" Style="{StaticResource PrimaryButton}" Click="Toggle_Click"/>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Hotkey" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <TextBox x:Name="HotkeyBox" Width="90" IsReadOnly="True" Text="F6" Cursor="Arrow"
                         ToolTip="Click, then press a key to rebind the global start/stop hotkey"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="HotkeyNote" Foreground="{StaticResource Bad}" FontSize="11" Margin="0,8,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</Window>
